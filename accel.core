CAPI=2:
# FuseSoC core for YOUR accelerator and YOUR testbench.
#
#   fusesoc --cores-root . run --target sim        isa:lab1:my_accel
#   fusesoc --cores-root . run --target sim_questa isa:lab1:my_accel
#
# The Makefile wraps both (make sim / make questa).
#
# THIS FILE IS A TEMPLATE, AND IT DOES NOT PARSE UNTIL YOU FILL IT IN. The
# `tb` fileset below ships with no files, and FuseSoC refuses a fileset with
# zero files:
#     Error validating data.filesets.tb.files must contain at least 1 items
# after which it ignores this core altogether, so every FuseSoC target --
# lint, sim, questa, synth -- fails with `isa:lab1:my_accel ... not found'.
# That is expected. List your RTL in `rtl` and your testbench in `tb`, and
# the targets come to life. `make vendor` and `make regs` do not need FuseSoC
# and work from day one.
#
# The naming contract (README.md): these must agree, and nothing checks it:
#   - ACCEL in the Makefile                         <accel>
#   - the top module in rtl/                        <accel>
#   - `name:` in data/accel.hjson                   <accel>
#   - the core name below                           isa:lab1:<accel>
#   - the `toplevel:` of the synth and lint targets <accel>
#   - the `toplevel:` of sim and sim_questa         tb_<accel>  (= TB in the Makefile)
# Rename them together the moment you know what your accelerator is called.
# The synthesis, place-and-route and power scripts read ACCEL, TB and CORE
# from the Makefile.

name: isa:lab1:my_accel:0.1.0
description: "TODO -- one line saying what your accelerator computes"

filesets:
  rtl:
    files:
      # TODO(you): your synthesisable sources, in dependency order.
      # Packages first, top module last. Delete what you do not have.
      #
      # - rtl/my_accel_pkg.sv         # your types, constants, functions
      # - rtl/my_accel_types_pkg.sv   # bus structs (OBI / reg interface)
      # - rtl/my_accel_reg_pkg.sv     # generated by reggen (`make regs`)
      # - rtl/my_accel_reg_top.sv     # generated by reggen (`make regs`)
      # - rtl/my_datapath.sv          # the kernel itself
      - rtl/my_accel.sv               # top: CSRs + control FSM + data port
    file_type: systemVerilogSource
    depend:
      # Do not reinvent these. common_cells has the FIFOs, counters,
      # arbiters, CDC primitives, LZC, stream registers and handshake
      # helpers you would otherwise write badly; tech_cells_generic has the
      # clock gate, the clock mux and the SRAM behavioural model. Both are
      # what X-HEEP itself is built out of, so using them now is what makes
      # Lab 3 integration boring.
      #   vendor/pulp_platform/common_cells/src/       read this directory
      #   vendor/pulp_platform/tech_cells_generic/src/
      - pulp-platform.org::register_interface
      - pulp-platform.org::common_cells
      # Using obi_pkg or the OBI typedef/assign macros (include/obi/*.svh)
      # in your RTL? Then add the OBI IP here too:
      # - pulp-platform.org::obi

  # The technology cells, in two flavours with the same module names. Every
  # target picks exactly one: behavioural models to simulate with, real
  # library cells to synthesise with. Mixing them, or synthesising the
  # behavioural ones, is how you end up with a netlist that means nothing.
  tech-generic:
    depend:
      - pulp-platform.org::tech_cells_generic

  tech-sg13g2:
    files:
      - implementation/tech/sg13g2/tc_clk_gating_sg13g2.sv  # -> sg13g2_slgcp_1
    file_type: systemVerilogSource

  # The memory wrapper, same pattern as the clock gate: one module name
  # (`sram_wrapper`), two implementations, the target picks one. NOT in the
  # filesets above, because an accelerator with no scratchpad does not need
  # it.
  #
  # The moment your accelerator wants one -- a line buffer, a coefficient
  # store, a result buffer -- instantiate `sram_wrapper` in your RTL and add
  # ONE of these two to each target below:
  #
  #     sim, sim_questa, lint  ->  mem-generic
  #     synth                  ->  mem-sg13g2
  #
  # Synthesising the behavioural model instead does not fail. It builds the
  # array out of flip-flops: a 1024x32 memory becomes 32 kbit of flops plus
  # the decoding, tens of times the area of the macro and nowhere near its
  # speed. That silence is why the wrapper exists. See §10 of
  # implementation/design_compiler/README.md.
  mem-generic:
    files:
      - implementation/tech/generic/sram_wrapper_generic.sv   # -> tc_sram
    file_type: systemVerilogSource
    depend:
      - pulp-platform.org::tech_cells_generic

  mem-sg13g2:
    files:
      - implementation/tech/sg13g2/sram_wrapper_sg13g2.sv     # -> RM_IHPSG13_1P_...
    file_type: systemVerilogSource

  tb:
    files:
      # TODO(you): your testbench. One testbench, both simulators.
      # Until a file is listed here this core does not parse, and every
      # FuseSoC target fails (see the top of this file). Uncomment, rename,
      # and delete the `[]` below.
      # - tb/tb_my_accel.sv
      []
    file_type: systemVerilogSource
    depend:
      # Verification IP you are expected to use rather than hand-roll:
      # obi_test has the OBI driver and obi_sim_mem (a memory that answers
      # your data port); reg_test has the register-interface driver that
      # writes your CSRs.
      - pulp-platform.org::obi_test
      - pulp-platform.org::reg_test

targets:
  default: &default
    filesets: [rtl]

  # Verilator 5: a testbench written in plain SystemVerilog compiles
  # directly with --binary --timing. No C++ harness.
  sim:
    <<: *default
    default_tool: verilator
    filesets: [rtl, tech-generic, tb]
    toplevel: tb_my_accel
    tools:
      verilator:
        mode: binary
        verilator_options:
          - --timing
          - --trace-fst
          # The vendored IPs are lint-clean for their own flow, not for ours.
          - -Wno-fatal

  # QuestaSim / ModelSim: same sources, same testbench, must agree. If the
  # two simulators disagree, one of them is telling you about a race in your
  # testbench -- fix it, do not pick the simulator you like.
  sim_questa:
    <<: *default
    default_tool: modelsim
    filesets: [rtl, tech-generic, tb]
    toplevel: tb_my_accel
    tools:
      modelsim:
        # The suppressed messages are all upstream-IP noise, not ours:
        #   2583   shift/width warnings inside the vendored IPs
        #   13314  an implicit-cast note from the reggen block
        #   13276  "Could not find field/method name (rready|reqpar|...)".
        #          The OBI_ASSIGN_* macros reference the optional OBI
        #          signals inside a branch selected by the config; with
        #          ObiDefaultConfig those fields do not exist and the branch
        #          is dead. Verilator prunes it, Questa still type-checks it
        #          and reports a *suppressible* error.
        #
        # -timescale gives every module that declares no `timeunit' the same
        # default. Without it Questa refuses to elaborate:
        #   ** Error: (vsim-3009) [TSCALE] - Module 'tb_my_accel' does not
        #   have a timeunit/timeprecision specification in effect, but other
        #   modules do.
        # 1ps precision matters later: the gate-level power runs annotate
        # SDF delays in picoseconds.
        vlog_options: [-sv, -timescale, 1ns/1ps,
                       -suppress, 2583, -suppress, 13314, -suppress, 13276]

  # Logic synthesis with Synopsys Design Compiler.
  #
  # edalize starts dc_shell in build/<core>/synth-design_compiler/ and hands
  # our script the file list it derived from the `rtl` fileset -- which is
  # why the paths below climb three levels back out to the lab. Everything
  # the script itself needs (libraries, constraints) lives in
  # implementation/design_compiler/scripts/.
  synth:
    <<: *default
    default_tool: design_compiler
    filesets: [rtl, tech-sg13g2]
    toplevel: my_accel
    tools:
      design_compiler:
        script_dir: ../../../implementation/design_compiler/scripts
        dc_script: dc_script.tcl
        report_dir: ../../../implementation/design_compiler/reports
        # The real library setup is in dc_script.tcl, which is sourced after
        # edalize writes these; it selects the PVT corner and compiles the
        # PDK's Liberty into .db on demand.
        libs: dw_foundation.sldb

  # Lint only, no simulation: the quickest feedback while writing RTL.
  lint:
    <<: *default
    default_tool: verilator
    filesets: [rtl, tech-generic]
    toplevel: my_accel
    tools:
      verilator:
        mode: lint-only
        verilator_options: [-Wall, -Wno-fatal]
